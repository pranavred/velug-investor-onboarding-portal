# Copy to .env.local. No credentials are needed for sample replay.
APP_NAME=Velug Investor Onboarding
APP_URL=http://localhost:3000
LIVE_AI_ENABLED=false
# Server-only Anthropic API key. Never expose it with a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
# Claude Opus 5.5 classifies page text and selects draft sources; Claude Sonnet 5.5 extracts fields from the PDF.
# Any claude-* model id is accepted; nothing is substituted automatically if a model is unavailable.
ANTHROPIC_CLASSIFICATION_MODEL=claude-opus-5-5
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5-5
ANTHROPIC_REVIEW_MODEL=claude-opus-5-5
REVIEW_DRAFTS_ENABLED=false
# Start your own Redis locally or use a deployer-owned TLS Redis instance.
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32
APP_SESSION_SECRET=
QUOTA_NAMESPACE=velug-investor-onboarding
GLOBAL_CALLS_PER_HOUR=20
SESSION_CALLS_PER_HOUR=5
