# Copy to .env.local. No credentials are needed for sample replay.
APP_NAME=Velug Investor Onboarding
APP_URL=http://localhost:3000
LIVE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-6-luna
# Requested GPT-5 snapshot. Check account access; no model is substituted automatically.
OPENAI_EXTRACTION_MODEL=gpt-5-2025-08-07
OPENAI_REVIEW_MODEL=gpt-5-2025-08-07
REVIEW_DRAFTS_ENABLED=false
# Start your own Redis locally or use a deployer-owned TLS Redis instance.
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32
APP_SESSION_SECRET=
QUOTA_NAMESPACE=velug-investor-onboarding
GLOBAL_CALLS_PER_HOUR=20
SESSION_CALLS_PER_HOUR=5
